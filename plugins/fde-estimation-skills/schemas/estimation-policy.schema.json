{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/fde-estimation/estimation-policy.schema.json",
  "title": "Estimation Policy",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "status",
    "review",
    "currency",
    "locale",
    "valid_from",
    "valid_until",
    "rate_sources",
    "roles",
    "cost_rules",
    "estimation_method"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_type": {"const": "estimation-policy"},
    "status": {"enum": ["draft", "final"]},
    "review": {"$ref": "#/$defs/humanReview"},
    "currency": {"type": "string", "minLength": 3},
    "locale": {"type": "string", "minLength": 2},
    "valid_from": {"type": "string", "minLength": 1},
    "valid_until": {"type": "string", "minLength": 1},
    "rate_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "location",
          "retrieved_at",
          "source_type",
          "seniority_levels",
          "compensation_scope"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "minLength": 1},
          "source_type": {
            "enum": [
              "kosa",
              "government-statistics",
              "salary-survey",
              "job-posting",
              "customer-policy"
            ]
          },
          "seniority_levels": {
            "type": "array",
            "items": {"enum": ["entry", "junior", "senior"]},
            "uniqueItems": true
          },
          "compensation_scope": {"type": "string", "minLength": 1}
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "occupation",
          "seniority",
          "seniority_confirmed",
          "monthly_rate",
          "rate_method",
          "source_ids",
          "rate_evidence",
          "rate_rationale"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "occupation": {"type": "string", "minLength": 1},
          "seniority": {"enum": ["entry", "junior", "senior"]},
          "seniority_confirmed": {"type": "boolean"},
          "monthly_rate": {"type": "number", "minimum": 0},
          "rate_method": {
            "enum": [
              "kosa-seniority",
              "web-estimate",
              "customer-provided"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "uniqueItems": true
          },
          "rate_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "observed_value",
                "observed_unit",
                "normalized_monthly_rate",
                "normalization_note"
              ],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "observed_value": {"type": "number", "minimum": 0},
                "observed_unit": {
                  "enum": ["monthly", "annual", "daily", "hourly"]
                },
                "normalized_monthly_rate": {
                  "type": "number",
                  "minimum": 0
                },
                "normalization_note": {"type": "string", "minLength": 1}
              }
            }
          },
          "rate_rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "cost_rules": {
      "type": "object",
      "required": [
        "overhead_rate_on_direct",
        "technical_fee_rate_on_direct_plus_overhead",
        "profit_rate_on_cost",
        "risk_rate_on_cost",
        "discount_rate",
        "tax_rate",
        "rounding_unit",
        "rounding_mode"
      ],
      "properties": {
        "overhead_rate_on_direct": {"type": "number", "minimum": 0},
        "technical_fee_rate_on_direct_plus_overhead": {
          "type": "number",
          "minimum": 0
        },
        "profit_rate_on_cost": {"type": "number", "minimum": 0},
        "risk_rate_on_cost": {"type": "number", "minimum": 0},
        "discount_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "tax_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "rounding_unit": {"type": "integer", "minimum": 1},
        "rounding_mode": {"enum": ["HALF_UP", "DOWN", "UP"]}
      }
    },
    "estimation_method": {
      "type": "object",
      "required": [
        "effort_unit",
        "method",
        "confidence_low_percent",
        "confidence_high_percent",
        "validity_days"
      ],
      "properties": {
        "effort_unit": {"const": "M/M"},
        "method": {"type": "string", "minLength": 1},
        "confidence_low_percent": {"type": "number"},
        "confidence_high_percent": {"type": "number"},
        "validity_days": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "humanReview": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "reviewed_by": {"type": "string"},
        "reviewed_at": {"type": "string"},
        "reference": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
