{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/fde-estimation/provenance.schema.json",
  "title": "FDE Estimate Provenance",
  "type": "object",
  "required": [
    "source_type",
    "source_reference",
    "captured_at",
    "confidence",
    "customer_confirmed",
    "evidence"
  ],
  "properties": {
    "source_type": {
      "enum": [
        "customer_request",
        "observed",
        "inferred",
        "validated",
        "implemented"
      ]
    },
    "source_reference": {"type": "string", "minLength": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["confirmed", "probable", "unverified"]},
    "customer_confirmed": {"type": "boolean"},
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
